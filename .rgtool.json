{
  "schema": 1,
  "id": "meet-copilot",
  "name": "Meet Copilot Pro",
  "description": "Asistente de escritorio que captura subtitulos de Teams/Zoom, los traduce en vivo y genera una minuta tecnica con IA al cerrar la reunion.",
  "category": "Productivity",
  "requirements": {
    "runtime": "python>=3.10",
    "system": []
  },
  "provision": {
    "strategy": "ManagedEnv",
    "command": "uv venv && uv pip install -r requirements.txt"
  },
  "preflight": ".venv\\Scripts\\python.exe doctor.py",
  "launch": {
    "kind": "Interpreter",
    "command": ".venv\\Scripts\\python.exe main.py"
  },
  "version": ".venv\\Scripts\\python.exe main.py --version",
  "artifacts": [
    { "label": "Minutas tecnicas", "path": "reuniones_logs", "pattern": "**/*_MINUTA.md", "limit": 0 },
    { "label": "Transcripciones crudas", "path": "reuniones_logs", "pattern": "**/*_RAW_FORENSE.txt", "limit": 0 },
    { "label": "Diagnosticos de captura", "path": "reuniones_logs/_diag", "pattern": "*", "limit": 0 }
  ],
  "elevated": false
}
